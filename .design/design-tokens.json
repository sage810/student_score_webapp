{
  "$description": "수행평가 웹앱(student score webapp)의 디자인 토큰. design-tokens.css와 같은 값이며, JS·Figma·다른 도구에서 읽을 때 쓴다.",
  "color": {
    "brand": {
      "purple": "#7132f5",
      "purpleDark": "#5741d8",
      "purpleTint": "rgba(133,91,251,0.12)",
      "purpleTintStrong": "rgba(133,91,251,0.20)"
    },
    "text": {
      "ink": "#101114",
      "inkSoft": "#686b82",
      "inkFaint": "#727589"
    },
    "surface": {
      "bg": "#f7f7fb",
      "surface": "#ffffff",
      "surfaceAlt": "#fafafc",
      "surfaceHover": "#fbfaff",
      "neutralFill": "#f1f1f6",
      "border": "#dedee5",
      "dotInactive": "#d4d4de"
    },
    "status": {
      "green": "#149e61",
      "greenInk": "#0b6b41",
      "greenTint": "rgba(20,158,97,0.14)",
      "red": "#c62f42",
      "redTint": "rgba(198,47,66,0.10)"
    },
    "statusBadge": {
      "done":     { "bg": "rgba(20,158,97,0.14)", "border": "#149e61", "text": "#0b6b41" },
      "current":  { "bg": "#7132f5", "border": "#5741d8", "text": "#ffffff" },
      "upcoming": { "bg": "#f1f1f6", "border": "#dedee5", "text": "#686b82" },
      "absent":   { "bg": "rgba(198,47,66,0.10)", "text": "#c62f42" }
    },
    "topbar": {
      "bg": "#101114",
      "text": "#ffffff",
      "textDim": "rgba(255,255,255,0.60)",
      "line": "rgba(255,255,255,0.40)"
    }
  },
  "typography": {
    "fontFamily": "'Pretendard', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "fontCdn": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css",
    "fontSize": {
      "2xs": "10px", "xs": "11.5px", "sm": "12.5px", "md": "13.5px", "base": "14px",
      "lg": "16px", "xl": "19px", "2xl": "22px", "total": "34px"
    },
    "fontWeight": { "regular": 400, "medium": 600, "bold": 700, "heavy": 800 },
    "lineHeight": { "tight": 1.3, "normal": 1.5 },
    "letterSpacingTitle": "-0.3px",
    "minFontSize": "12px (배지·열 제목·라벨 포함. 표 머리글의 배점 10px은 예외)"
  },
  "spacing": {
    "unit": "4px 배수 (2px 반 단계 허용)",
    "scale": { "0.5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px" },
    "pageGutter": "16px"
  },
  "radius": { "sm": "6px", "control": "10px", "md": "12px", "lg": "20px", "pill": "999px" },
  "shadow": {
    "card": "0 4px 24px rgba(16,17,20,0.06)",
    "bottomBar": "0 -6px 20px rgba(16,17,20,0.06)",
    "focusRing": "0 0 0 3px rgba(133,91,251,0.12)"
  },
  "border": { "width": "1px", "widthControl": "1.5px" },
  "size": {
    "touchMin": "44px",
    "touchMinSmall": "24px",
    "contentMaxStudent": "520px",
    "contentMaxAdmin": "980px"
  },
  "motion": { "ease": "ease", "fast": "0.15s", "base": "0.35s" },
  "zIndex": { "tableHead": 2, "topbar": 25, "bottomBar": 30 },
  "breakpoints": {
    "topbarCompact": "1100px 이하",
    "topbarGrid3": "780px 이하",
    "bottomBarStack": "720px 이하",
    "rowsStack": "640px 이하"
  },
  "rules": [
    "포인트 색은 보라(#7132f5) 하나. 상태는 완료=초록, 이번 수행=진한 보라, 예정=회색, 결시/에러=빨강.",
    "비활성·예정 표시는 opacity로 흐리게 하지 않고 배경·글자색을 따로 지정한다 (대비 4.5:1 유지).",
    "글자가 초록 틴트 위에 놓일 때는 --green이 아니라 --green-ink를 쓴다.",
    "안내 문구(placeholder)는 --ink-faint, 보조 글자는 --ink-soft.",
    "버튼·탭 터치 영역 44px 이상, 체크박스·칩 × 버튼 24px 이상.",
    "모든 입력칸은 label 또는 aria-label을 연결하고, 확대(zoom)를 막지 않는다.",
    "경고 표시는 이모지 대신 SVG 아이콘.",
    "긴 글은 낱말(띄어쓰기) 단위로 줄바꿈하고 text-wrap:balance로 줄 길이를 고르게 한다."
  ]
}
